# Local development values only (matching docker-compose.yml). Never put real secrets in this file.
DATABASE_URL=postgresql+psycopg://takeoff:takeoff@localhost:5432/takeoff
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=takeoff-dev
S3_ACCESS_KEY=takeoff
S3_SECRET_KEY=takeoff-dev-only
SECRET_KEY=dev-only-change-me
APP_URL=http://localhost:8000
COOKIE_SECURE=false
SIGNUP_ALLOWLIST=
MAIL_BACKEND=console
# Vision model for schedule elevations (sends drawing crops to the Anthropic API; billed). Off by default.
VISION_ENABLED=false
# ANTHROPIC_API_KEY=  (set in your shell or a real .env, never in this file)
